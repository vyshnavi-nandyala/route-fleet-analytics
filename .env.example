# Snowflake credentials
SNOWFLAKE_ACCOUNT=your_account_identifier        # e.g. xy12345.us-east-1
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_DATABASE=FLEET_ANALYTICS
SNOWFLAKE_WAREHOUSE=FLEET_WH

# AWS credentials (for S3 upload)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1

# S3 bucket
FLEET_S3_BUCKET=route-fleet-analytics-raw

# Slack webhook (for Airflow failure alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Airflow (for CD pipeline)
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=admin
