route_fleet_analytics:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: SYSADMIN
      database: FLEET_ANALYTICS
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'FLEET_WH') }}"
      schema: SILVER
      threads: 4
      client_session_keep_alive: false
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: SYSADMIN
      database: FLEET_ANALYTICS
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE', 'FLEET_WH') }}"
      schema: SILVER
      threads: 8
      client_session_keep_alive: false
